# JoJo The Jeweler — environment
#
# Nothing here is needed to run the site today: the catalogue is read from src/data/catalog.json
# (generated from content/shopify/). These are for the Shopify Storefront API connection and
# the asset-collection scripts.
#
# ⚠ A `VITE_`-prefixed variable is NOT a secret — Vite inlines it into the public bundle.
# Only the read-only Storefront token (designed to be public) is safe with a VITE_ prefix.
# ⛔ Never put an Admin API token (shpat_…) in any VITE_ variable or in this repo.

# Shopify shop domain (public)
VITE_SHOPIFY_DOMAIN=jojoxwaves.myshopify.com
# Storefront API public access token (read-only, safe to publish)
VITE_SHOPIFY_STOREFRONT_TOKEN=
# Pin the API version
VITE_SHOPIFY_API_VERSION=2025-07

# Public address of the site, for sitemap.xml and robots.txt (build time only)
SITE_ORIGIN=https://jojo-the-jeweler.vercel.app

# ── Server/CI only (never VITE_-prefixed, never committed) ────────────────────
# Bright Data API key for the Instagram archive script (scripts/fetch-instagram.mjs).
# In GitHub Actions this comes from the BRIGHTDATA_API_KEY repository secret.
BRIGHTDATA_API_KEY=
# Storefront password of the existing (password-protected) Shopify store, for scripts/collect-assets.mjs
STORE_PASSWORD=
