    "handle": "custom-jewelry-inquiry",
    "body_html": "<div class=\"selector-wrapper bcpo-simple bcpo-instructions\" data-unique=\"_sxlkes272\">\n<div style=\"text-align: left;\">Disclaimer: This is a form to receive a free quote &amp; consultation only.</div>\n<div style=\"text-align: left;\"><br></div>\n<div style=\"text-align: left;\">Once you fill out the form we will provide you with a quote, if you wish to proceed we will take a deposit through wire, zelle, or cashapp.</div>\n</div>\n<div style=\"text-align: center;\" class=\"selector-wrapper bcpo-simple bcpo-default\" data-unique=\"_oqhsb56xc\"><br></div>\n<div style=\"text-align: center;\" class=\"selector-wrapper bcpo-simple bcpo-default\" data-unique=\"_oqhsb56xc\"><br></div>\n<div class=\"selector-wrapper bcpo-simple bcpo-default\" data-unique=\"_oqhsb56xc\">\n<div class=\"product-block product-block--tab\">\n<div class=\"collapsibles-wrapper collapsibles-wrapper--border-bottom\">\n<div class=\"collapsible-content collapsible-content--all is-open\" id=\"Product-content-description6646253256756\">\n<div class=\"collapsible-content__inner rte\">\n<div>\n<div>\n<div style=\"text-align: center;\"><strong>How Your Custom Is Made</strong></div>\n<div>\n<div style=\"text-align: center;\"><strong>Part One: The Sketch &amp; Design</strong></div>\n<div style=\"text-align: center;\"><strong><img alt=\"\" src=\"https://cdn.shopify.com/s/files/1/0557/0710/7380/files/SmartSelect_20220503-131926_Drive_480x480.gif?v=1652210015\"></strong></div>\n<div style=\"text-align: center;\">\n<strong></strong><br>\n</div>\n<div style=\"text-align: center;\"><strong> Part Two: Mold and Production<img src=\"https://cdn.shopify.com/s/files/1/0557/0710/7380/files/ezgif.com-gif-maker_480x480.gif?v=1652211044\" alt=\"\"></strong></div>\n<div style=\"text-align: center;\"><strong>Part Three: Polish, Inspection and Delivery</strong></div>\n<div><strong><img style=\"display: block; margin-left: auto; margin-right: auto;\" src=\"https://cdn.shopify.com/s/files/1/0557/0710/7380/files/SmartSelect_20220503-132035_Drive_480x480.gif?v=1652211173\" alt=\"\"></strong></div>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n<div class=\"product-block product-block--tab\">\n<div class=\"collapsibles-wrapper collapsibles-wrapper--border-bottom\"><form class=\"contact-form\" id=\"contact-contact\" action=\"https://flawlessdiamondsco.com/contact#contact-contact\" method=\"post\"></form></div>\n</div>\n</div>",
